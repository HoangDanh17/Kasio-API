{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ConnectionStrings": {
    "WriteDb": "Host=localhost;Port=5432;Database=kasio;Username=postgres",
    "Redis": "localhost:6380,abortConnect=false"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "ExchangeName": "Kasio.events"
  },
  "Cap": { "EnableDashboard": true },
  "Database": { "MigrateOnStartup": false },
  "Jwt": {
    "Issuer": "Kasio",
    "Audience": "Kasio.Client",
    "Secret": "",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@gmail.com",
    "Password": ""
  }
}
